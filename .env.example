# Copy this file to `.env` and fill in your own values. `.env` is never committed to Git.

# Only needed if llm.backend is "api" in config/settings.yaml (the default uses your Claude subscription).
ANTHROPIC_API_KEY=

# Email notifications (optional): the daily report is sent to NOTIFY_TO only.
# Gmail: SMTP_PASSWORD must be an APP PASSWORD (https://myaccount.google.com/apppasswords), without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
NOTIFY_TO=
SMTP_PASSWORD=

# Optional: override where the SQLite database is stored (see config/settings.yaml)
# VJH_DB_PATH=
